
#include<stdio.h>
#define SIZE 5
int queue[SIZE];
int front=-1,rear=-1;
void enqueue()
{
    int item;
    if(rear==SIZE-1)
        printf("Queue Overflow\n");
    else
    {
        printf("Enter the element: ");
        scanf("%d",&item);
        if(front==-1)
            front=0;
        rear++;
        queue[rear]=item;
        printf("Element inserted successfully\n");
    }
}
void dequeue()
{
    if(front==-1||front>rear)
        printf("Queue Underflow\n");
    else
    {
        printf("Deleted element = %d\n",queue[front]);
        front++;
        if(front>rear)
            front=rear=-1;
    }
}
void display()
{
    int i;
    if(front==-1)
        printf("Queue is Empty\n");
    else
    {
        printf("Queue elements are:\n");
        for(i=front;i<=rear;i++)
            printf("%d\n",queue[i]);
    }
}
void main()
{
    int choice;
    while(1)
    {
        printf("\n--- QUEUE OPERATIONS ---\n");
        printf("1. Enqueue\n");
        printf("2. Dequeue\n");
        printf("3. Display\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d",&choice);
        switch(choice)
        {
            case 1:
                enqueue();
                break;
            case 2:
                dequeue();
                break;
            case 3:
                display();
                break;
            case 4:
                return;
            default:
                printf("Invalid Choice\n");
        }
    }
}
